# Cấu hình của ứng dụng backend. Dùng:
#   cp env/.env.example env/.env.development
# File env/.env.development đã nằm trong .gitignore — KHÔNG commit.
# Biến thật trên ECS do nền tảng cung cấp; biến đã có trong môi trường luôn thắng file này.
# Mọi giá trị dưới đây được kiểm tra khi khởi động (src/config/validation.schema.ts):
# thiếu hoặc sai là app từ chối chạy. Giá trị mẫu chỉ dùng cho local, không phải secret thật.

# ---------- App ----------
NODE_ENV=development
PORT=3000
# api = chỉ HTTP · worker = chỉ outbox/risk/notification · both = tất cả trong 1 process (local)
APP_ROLE=both
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=debug
# Danh sách origin được phép gọi từ trình duyệt, phân tách bằng dấu phẩy. Rỗng = dev mở, production đóng.
CORS_ORIGINS=
# Số reverse proxy phía trước (ALB = 1). Quyết định req.ip dùng cho rate limit theo IP.
# Bắt buộc >= 1 khi NODE_ENV=production: để 0 sau ALB thì mọi khách chung một địa chỉ IP.
TRUST_PROXY_HOPS=0

# ---------- PostgreSQL (docker compose) ----------
DATABASE_URL=postgres://banking:banking_local_only@localhost:5432/banking
DATABASE_POOL_MAX=10
# Bắt buộc true khi NODE_ENV=production (mã hóa đường truyền tới RDS)
DATABASE_SSL=false
# File PEM chứa CA để xác minh chứng chỉ của server. Node KHÔNG tin CA của RDS mặc định, nên nối
# RDS thật cần bundle của AWS (xem backend/README.md, mục Docker). Chỉ dùng được khi DATABASE_SSL=true.
# DATABASE_SSL_CA_PATH=/etc/ssl/rds/global-bundle.pem
# Giới hạn chờ (ms) để một tài khoản nóng không làm cạn pool kết nối và kéo sập cả API.
# Hết hạn thì trả 503 + Retry-After; client gửi lại cùng Idempotency-Key. Không được đặt 0 (= chờ mãi).
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# ---------- Redis / Valkey ----------
# Bắt buộc rediss:// (TLS) khi NODE_ENV=production
REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=50

# ---------- Queue (ElasticMQ local, tương thích SQS) ----------
AWS_REGION=ap-southeast-1
SQS_ENDPOINT=http://localhost:9324
# Chỉ bắt buộc với APP_ROLE=worker hoặc both
SQS_RISK_QUEUE_URL=http://localhost:9324/000000000000/risk-events
SQS_NOTIFICATION_QUEUE_URL=http://localhost:9324/000000000000/notification-events
# ElasticMQ không kiểm tra credential. Trên AWS dùng IAM role của task, KHÔNG dùng key tĩnh.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------- Auth (Cognito) ----------
# Bắt buộc khi NODE_ENV là staging hoặc production; local có thể bỏ trống.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_ISSUER=
# Thời gian sống của access token; cũng là TTL của mốc "đã thu hồi phiên" trong Redis
ACCESS_TOKEN_TTL_SECONDS=900

# ---------- Giới hạn nghiệp vụ (giả định, xem docs/01 BR-06) ----------
# Tiền là SỐ NGUYÊN đồng (BR-01): chỉ chữ số, không dấu phẩy, không phần thập phân.
TRANSFER_LIMIT_PER_TX=50000000
TRANSFER_LIMIT_PER_DAY=200000000
IDEMPOTENCY_KEY_RETENTION_DAYS=7
RATE_LIMIT_TRANSFERS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_IP_PER_MINUTE=100
