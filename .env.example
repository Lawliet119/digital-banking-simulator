# Chỉ dùng cho docker-compose.yml (PostgreSQL local). Dùng:  cp .env.example .env
# Cấu hình của ứng dụng backend nằm riêng ở backend/env/.env.example.
# File .env đã nằm trong .gitignore. Giá trị dưới đây CHỈ dùng cho local, không phải secret thật.

POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking_local_only
