# Copy thành .env để chạy local:  cp .env.example .env
# File .env đã nằm trong .gitignore. Giá trị dưới đây CHỈ dùng cho local, không phải secret thật.

# ---------- App ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---------- PostgreSQL (docker compose) ----------
POSTGRES_DB=banking
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking_local_only
DATABASE_URL=postgres://banking:banking_local_only@localhost:5432/banking
DATABASE_POOL_MAX=10

# ---------- Redis / Valkey ----------
REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=50

# ---------- Queue (ElasticMQ local, tương thích SQS) ----------
AWS_REGION=ap-southeast-1
SQS_ENDPOINT=http://localhost:9324
SQS_RISK_QUEUE_URL=http://localhost:9324/000000000000/risk-events
SQS_NOTIFICATION_QUEUE_URL=http://localhost:9324/000000000000/notification-events
# ElasticMQ không kiểm tra credential; trên AWS dùng IAM role của task, KHÔNG dùng key tĩnh
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------- Auth (Cognito) — điền khi có user pool dev ----------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# ---------- Business limits (giả định, xem docs/01 BR-06) ----------
TRANSFER_LIMIT_PER_TX=50000000
TRANSFER_LIMIT_PER_DAY=200000000
IDEMPOTENCY_KEY_RETENTION_DAYS=7
