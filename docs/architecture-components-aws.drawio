        <!-- AMAZON RDS POSTGRESQL 17 -->
        <mxCell id="ico_rds" value="&lt;b&gt;Amazon RDS for PostgreSQL 17&lt;/b&gt;&lt;br&gt;(TLS verify-full | Roles: dbs_api, dbs_worker, dbs_migrator)&lt;br&gt;• Sync: users, customers, accounts, transfers, ledger_entries, idempotency_keys&lt;br&gt;• Async/Append-only: outbox_events, processed_events, audit_log,&lt;br&gt;  risk_decisions, fraud_flags, notification_log, reconciliation_runs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="sub_private_data">
